{"nodes": [{"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog", "label": "M4b Fault Catalog Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_fault_seams", "label": "Fault seams (fault.* bus signals, identity defaults)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model seams land FIRST with identity defaults (multiplicative faults at 1.0, additive at 0) so no-fault runs are bit-identical; the plumbing lands second."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_fault_rng_stream", "label": "Dedicated fault RNG stream (model_rng(seed, 'elrs-faults'))", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Ruling 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refines spec decision 7: the model's own stream stays byte-identical to pre-M4b, so even fault-active runs differ from fault-free ones only in the loss decisions themselves."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_vtx_interference_handle", "label": "VtxInterferenceHandle (runtime emitter injection)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Ruling 4, Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rides a shared handle, not bus signals (the OsdHandle pattern); per-frequency caching stays correct because the handle only changes at set_fault time, outside the tick."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_vibration_model", "label": "IMU vibration model (VibrationParams, rotating imbalance force)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 2, ruling 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F = imbalance*omega^2 rotating in the prop plane at phase theta + azimuth; rigid-body, below-resonance transmission only; every constant an estimate recorded in docs/research/faults.md; imbalance 0 contributes exactly zero."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_protocol_8", "label": "Protocol 8 (Fault oneof, fault_injected/fault_cleared events)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_fault_enum", "label": "vehicle::Fault enum with set_fault / clear_faults", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 3 step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drone failures are behaviour, simulator failures are loud: a fault a quad cannot carry (no VTX, bad index) is InvalidArgument at inject, never a no-op."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_python_faults", "label": "python/ofs/faults.py fault dataclasses", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 3 step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_radio_faults", "label": "RadioLoss and BurstLoss faults", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both fold into the same received conjunction; BurstLoss window math is deterministic: in_burst = on > 0 and time_s % (on+off) < on, phase anchored at session start."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_powertrain_faults", "label": "MotorFailure and PropDamage faults", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "theta integrates regardless of scale - a stopped motor has a frozen phase, the physically right vibration input; a dead motor draws no current and coasts down through drag."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_pack_gyro_video_faults", "label": "WeakCell, GyroFault and VtxInterference faults", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fault.battery.weak_cell carries cell index + 1 (0 = none) so the synthesis can find it; VtxInterference on a quad without [vtx] is InvalidArgument."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_msp_status_decode", "label": "MSP_STATUS arming-disable flags decode (python/tests/msp_status.py)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 7, ruling 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real RX-loss failsafe never touches the pilot-switch path (BOXFAILSAFE), so the decoded observable is the arming-disable flags: RX_FAILSAFE = 1 << 2 from stage 1, FAILSAFE = 1 << 1 once stage 2 engages."}, {"id": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_weak_cell_synthesis", "label": "Weak-cell voltage synthesis (battery_cell_voltages)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Ruling 7, Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "voltage = ocv - I*(r0 + dr) - v1 - dv applies only to the published pack voltage; SoC, current and the v1 polarization state use the untouched Thevenin math."}], "edges": [{"source": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog", "target": "docs_superpowers_specs_2026_10_11_m4_sandbox_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "header (spec 3, 1 decisions 3/7/9, 7, 8 M4b row)", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_fault_seams", "target": "docs_superpowers_specs_2026_10_11_m4_sandbox_design_faults_bus_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "architecture (the M2 RadioLinkLoss pattern generalized)", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_protocol_8", "target": "docs_superpowers_specs_2026_10_11_m4_sandbox_design_protocols", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "Task 3 (spec 7 protocol 8)", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_11_m4b_fault_catalog_protocol_8", "target": "docs_superpowers_plans_2026_10_11_m3e_video_extras_protocol_7", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-11-m4b-fault-catalog.md", "source_location": "global constraints (PROTOCOL_VERSION goes 7 -> 8)", "weight": 1.0}, {"source": "docs_superpowers_pl