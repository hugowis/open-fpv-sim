{"nodes": [{"id": "docs_superpowers_m3c_carried_debt_md", "label": "M3c carried debt", "file_type": "document", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_m3c_carried_debt_prop_sphere_ruling", "label": "Ruling: PROP_SPHERE_RADIUS_M is 2.0 cm, not the spec's 1.5 cm", "file_type": "rationale", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two claims conflicted on the shipped quad: at 1.5 cm the worst ring-to-body gap was 0.12024 m and the spec's own no-gap claim failed by 0.24 mm. The safety claim won over the example figure; at 2 cm the worst gap is 0.1152 m."}, {"id": "docs_superpowers_m3c_carried_debt_body_sphere_ruling", "label": "Ruling: 4 cm body sphere accepted (belly resting is behaviour)", "file_type": "rationale", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generated body sphere reaches 1 cm past the shipped quad's legs (4 cm radius against 3 cm legs), so on flat ground the quad rests on its belly sphere. The maintainer's manual flight check (2026-10-11) accepted it: the rest and takeoffs feel right, no geometry change wanted."}, {"id": "docs_superpowers_m3c_carried_debt_link_down_ruling", "label": "Ruling: LINK_DOWN has no edge on a never-up link", "file_type": "rationale", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 50 km / 10 mW link is never up, so the events are raised on the remembered up-to-down transition; a link that starts down and stays down raises nothing. LINK_DOWN is pinned on the fault test instead."}, {"id": "docs_superpowers_m3c_carried_debt_handset_antenna_ruling", "label": "Ruling: the handset transmits on its active antenna", "file_type": "rationale", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real dual-antenna handsets alternate per packet (or bind per direction); a per-packet schedule would be closer. Modelling simplification recorded as carried debt."}, {"id": "docs_superpowers_m3c_carried_debt_ci_flake", "label": "CI flake: MSP_SET_VTX_CONFIG timeout (cold-start hypothesis, deferred verdict)", "file_type": "concept", "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_m3c_carried_debt_prop_sphere_ruling", "target": "docs_research_collision_no_gap_claim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_md", "target": "docs_superpowers_m3c_carried_debt_prop_sphere_ruling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_md", "target": "docs_superpowers_m3c_carried_debt_body_sphere_ruling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_md", "target": "docs_superpowers_m3c_carried_debt_link_down_ruling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_md", "target": "docs_superpowers_m3c_carried_debt_handset_antenna_ruling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_md", "target": "docs_superpowers_m3c_carried_debt_ci_flake", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_body_sphere_ruling", "target": "docs_research_collision_collision_spheres", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_link_down_ruling", "target": "docs_research_elrs_link_packet_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_m3c_carried_debt_handset_antenna_ruling", "target": "docs_research_elrs_link_diversity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/m3c-carried-debt.md", "source_location": null, "weight": 1.0}], "hyperedges": []}