, "weight": 1.0}, {"source": "docs_research_sitl_interface_ofs_sitl_patch", "target": "docs_research_sitl_interface_osd_c_upstream_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_lockstep_findings", "target": "docs_research_sitl_interface_sitl_clock_collapse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_lockstep_findings", "target": "docs_research_sitl_interface_gyropid_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_lockstep_findings", "target": "docs_research_sitl_interface_external_time_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_sitl_clock_collapse", "target": "docs_research_sitl_interface_ofs_sitl_patch", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_lockstep_protocol", "target": "docs_research_sitl_interface_lockstep_findings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_lockstep_protocol", "target": "docs_research_sitl_interface_sitl_udp_ports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md"