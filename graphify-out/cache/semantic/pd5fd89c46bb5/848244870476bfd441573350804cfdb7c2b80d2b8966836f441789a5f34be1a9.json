{"nodes": [{"id": "docs_superpowers_plans_2026_10_11_m4a_component_library", "label": "M4a Component Library Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-11-m4a-component-library.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m4a_component_library_part_module", "label": "ofs-config::part module (six part kinds + loaders)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m4a-component-library.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m4a_component_library_provenance_walker", "label": "Mandatory provenance walker (check_provenance)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4a-component-library.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every leaf path under the part's data tables (tables recurse, arrays are single leaves - prop.ct_table is one parameter) must appear in [provenance], and every [provenance] key must be such a path."}, {"id": "docs_superpowers_plans_2026_10_11_m4a_component_library_schema_5_cutover", "label": "Quad schema 5 hard cutover (QuadFile / PartRefs)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m4a-component-library.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic cutover: after it a quad is references plus wiring, QuadConfig loses Deserialize and is no longer the shape of any TOML file; the schema-4 refusal names what moved."}, {"id": "docs_superpowers_plans_2026_10_11_m4a_component_library_library_root", "label": "Library root resolution (library_root / OFS_LIBRARY)", "file_type": "concept", "source_file": "docs/superpowers/p