{"nodes": [{"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_md", "label": "M3a: OSD and VTX Control Implementation Plan (2026-10-08)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_reply_capture", "label": "Reply trailer codec and receive buffers (REPLY_MAX 530, UART1 never captured)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_no_vtxtable_ruling", "label": "Ruling: no vtxtable lines in the diff", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The SITL build has no USE_VTX_TABLE; Betaflight uses the factory bands and builds its power list from the dBm values the VTX reports in its settings reply, so [vtx].power_levels_dbm is what the VTX reports and the diff has no vtxtable lines."}, {"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_cell_count_ruling", "label": "Ruling: the diff forces the cell count (force_battery_cell_count)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Betaflight guesses the cell count from the first voltage it sees: a 6S pack at 20.4 V (2% charge) was detected as 5S, so no low-battery warning ever appeared; with the count forced the same pack raises LOW BATTERY."}, {"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_crash_hazard", "label": "Hazard: SmartAudio enabled without an answering VTX crashes Betaflight SITL", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Betaflight SITL crashes (SIGSEGV) when its OSD draws the VTX channel element and no VTX answers; the quad's config check rejects a diff that enables SmartAudio without a [vtx] section at load."}, {"id": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_schema_protocol", "label": "Quad schema 3 / protocol 3 (M3a: [esc_telemetry], [osd], [vtx])", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_md", "label": "M3a OSD/VTX design spec (2026-10-08)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_md", "target": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_md", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_md", "target": "docs_superpowers_specs_2026_10_04_open_fpv_sim_design_md", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_08_m3a_osd_vtx_md", "target": "crates_ofs_video", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-08-m3a-osd-vtx.md", "source_location": null, "weight": 1.0}, {"source": "docs_