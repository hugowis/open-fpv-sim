{"nodes": [{"id": "docs_dev_setup_md", "label": "Developer setup (docs/dev-setup.md)", "file_type": "document", "source_file": "docs/dev-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_dev_setup_ofs_sitl_launch", "label": "OFS_SITL_LAUNCH environment variable (SITL argv override)", "file_type": "concept", "source_file": "docs/dev-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overrides fc.launch in quad files; on Windows points at wsl.exe and the bridge discovers the WSL VM and host IPs (works with WSL's default NAT networking)."}, {"id": "docs_dev_setup_ofs_sitl_cleanup", "label": "OFS_SITL_CLEANUP (pkill -x betaflight_SITL before/after launch)", "file_type": "concept", "source_file": "docs/dev-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stale SITL would otherwise answer instead of the new one. It matches the process name (-x): never use pkill -f, which also matches the shell running it."}, {"id": "docs_dev_setup_godot_test_runner", "label": "Godot headless test runner (timeout -k guard)", "file_type": "concept", "source_file": "docs/dev-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Godot script with a parse error exits 1, but a script that raises a runtime error never exits; the runner wraps every Godot call in timeout -k and treats a kill (rc 124) as a failure, so a broken test script can never yield a green run."}, {"id": "docs_dev_setup_esc_telemetry_uart3", "label": "KISS ESC telemetry on UART3 ([esc_telemetry], battery as KISS frames)", "file_type": "concept", "source_file": "docs/dev-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_dev_setup_msp_displaypor