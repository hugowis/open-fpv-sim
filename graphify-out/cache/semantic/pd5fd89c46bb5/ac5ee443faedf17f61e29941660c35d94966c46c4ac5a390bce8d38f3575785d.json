{"nodes": [{"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras", "label": "M3e Video Extras Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_subviewport_fpv_composite", "label": "FPV composite in a fixed-resolution SubViewport", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project-level render settings do not apply to SubViewports so MSAA moves onto the SubViewport (msaa_3d = 2); the SubViewport is what DVR captures and what the aspect setting sizes."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_field_drop_model", "label": "Field drop model (field_drop_probability / FIELD_DROP_P_MAX)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 2, ruling 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Piecewise: 0 at SNR >= UNSTABLE_SNR_DB (6 dB), ramps linearly to FIELD_DROP_P_MAX (0.5) at LOST_SNR_DB (3 dB), 0 again below 3 dB - a lost receiver outputs static, it does not hold frames; one seeded draw per field step."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_protocol_7", "label": "Protocol 7 (VideoLink field_valid + latency_ms)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_receiver_latency_ms", "label": "Receiver glass-to-glass latency config (receiver.latency_ms)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 2 step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 40 ms = 2 fields; quantized down to whole fields at register time because a pipeline that buffers fields delivers whole fields."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_delayed_composite", "label": "Client delayed composite (FpvBuffer / field_floor / StateBuffer::sim_now)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection lives in ofs-client as a Rust function unit-tested without Godot; a dropped field shows the previous one (stateless walk-back bounded by the 64-field buffer)."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_dvr_mjpeg_avi_muxer", "label": "DVR MJPEG AVI muxer (DvrWriter) and Godot capture (dvr.gd)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Tasks 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File I/O on a worker thread; at most 50 frames in flight, further ones dropped and counted - a recording that hiccups is fine, a flight that stutters is not."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_tramp_codec", "label": "Tramp codec (crates/ofs-video/src/tramp.rs)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16-byte frames 0x0F cmd payload crc 0x00; CRC is a u8 sum of bytes 1..=13 (vtx_tramp.c trampChecksum, the 0x0F excluded); the model answers 'r','v','s' and applies 'F','P','I' silently."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_vtx_kind_tramp", "label": "VtxKind::Tramp config variant", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 6 step 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_opendrone_5f_tramp_quad", "label": "quads/opendrone-5f-tramp.toml (Tramp live-test quad)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tramp has no band/channel mode (frequency changes arrive only as 'F'); power levels are the FC's built-in trampPowerTable {25, 100, 200, 400, 600} mW."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_font_page_1", "label": "OSD font page 1 (bold.mcm second atlas page)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Font download requires explicit user approval in specific words (the M3a discipline); arriving pages >= 2 draw page 0 defensively."}, {"id": "docs_superpowers_plans_2026_10_11_m3e_video_extras_fpv_aspect_setting", "label": "fpv_aspect setting (4:3 / 16:9 / window)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-11-m3e-video-extras.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4:3 new default; the chase view always fills the window; boxed aspects center a fixed-resolution picture like goggles do (960x720 or 1280x720 internal)."}], "edges": [{"source": "docs_superpowers_plans_2026_10_11_m3e_video_extras", "target": "docs_superpowers_specs_2026_10_10_m3e_video_extras_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score