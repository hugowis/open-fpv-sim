{"nodes": [{"id": "docs_research_video_link_md", "label": "The analog video link model (docs/research/video-link.md)", "file_type": "document", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_video_link_propagation_model", "label": "5.8 GHz per-PAL-field propagation model (FSPL, patterns, polarization, body shadow, diffraction, bounce, Rician fading)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_video_link_knife_edge_search", "label": "Golden-section knife-edge obstruction search", "file_type": "rationale", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A golden-section search on the object's signed distance finds the deepest point of the path exactly for the convex shapes of the world file, however thin the object or long the path, so a thin post on a long path is never stepped over (32 samples would miss it)."}, {"id": "docs_research_video_link_circular_antennas", "label": "Why FPV uses circular antennas", "file_type": "rationale", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reflection reverses the hand of a circular wave, so a circular receiver takes the reflected ground-bounce ray with the 20 dB cross-polarization loss (a ripple under 1.5 dB); with linear antennas the two rays nearly cancel into deep fades when flying low."}, {"id": "docs_research_video_link_interference", "label": "Interference and adjacent-channel rejection (emitters, noise floor -93 dBm)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_video_link_picture_thresholds", "label": "SNR-to-picture thresholds (grain, sparkles, colour, tearing, sync lost/relock)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_video_link_latency", "label": "Glass-to-glass latency (latency_ms, quantized down to whole PAL fields)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The client composites the whole picture from one field-quantized instant, sim_now - latency, so the picture ages as a unit at the field rate \u2014 the judder of real analog glass. Default 40 ms = 2 fields is an estimate for a typical analog pipeline."}, {"id": "docs_research_video_link_field_drops", "label": "Field drops in the marginal band (6 to 3 dB, dropped field holds the picture)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The drop probability ramps linearly from 0 at 6 dB to FIELD_DROP_P_MAX 0.5 at 3 dB and is 0 outside the band; one seeded RNG draw per field after the fading draws keeps lockstep runs dropping the same fields seed for seed."}, {"id": "docs_research_video_link_link_budget", "label": "Video link budget (25 mW clean to ~100 m, sync lost at 2 km; 600 mW to 500 m)", "file_type": "concept", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crates_ofs_video_src_propagation_rs", "label": "crates/ofs-video/src/propagation.rs (pure physics functions)", "file_type": "code", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crates_ofs_video_src_link_rs", "label": "crates/ofs-video/src/link.rs (receiver model on the bus)", "file_type": "code", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "godot_ui_video_gd", "label": "godot/ui/video.gd (degradation shader layer over OSD and HUD)", "file_type": "code", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_md", "label": "M3b analog video link design spec (2026-10-09)", "file_type": "document", "source_file": "docs/research/video-link.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_video_link_md", "target": "crates_ofs_video_src_propagation_rs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/video-link.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_video_link_md", "target": "crates_ofs_video_src_link_rs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/video-link.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_video_link_md", "target": "godot_ui_video_gd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/video-link.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_video_link_md", "target": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_md", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/video-link.md", "source_location": null, "weight": 1.0}, {"source": "doc