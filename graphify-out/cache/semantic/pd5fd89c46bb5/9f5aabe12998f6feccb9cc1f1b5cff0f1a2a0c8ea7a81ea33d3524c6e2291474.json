{"nodes": [{"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design", "label": "M3d Flight-Controller Telemetry Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_crsf_downlink", "label": "CRSF telemetry riding the ELRS downlink", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "decision 1, 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telemetry scheduled onto downlink slots is lost when the link is down, like a real radio; exposing the decoded frames directly would let telemetry survive link loss (only half the milestone)."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_dshot_emulation", "label": "DShot telemetry emulation without USE_DSHOT (SITL stub)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The M3d spike proved the RPM filter needs no DShot driver: the sitl.c stub plus USE_DSHOT_TELEMETRY / USE_RPM_FILTER deliver per-motor eRPM."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_erpm_block", "label": "eRPM datagram block (index 250, per-motor eRPM/100)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "u16 covers 6.55 M eRPM; index 250 sits above any UART index; staged per datagram so lockstep stays deterministic; a legacy simulator leaves the stub at zero and the RPM filter harmless."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_rpm_filter", "label": "Betaflight RPM filter fed per-motor eRPM", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "2-3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_pole_pairs_const", "label": "POLE_PAIRS constant (ofs-fc::sitl::esc_telemetry)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The named constant 7 the KISS shim already carries; it moves to config only if a motor ever disagrees (carried debt, closed by M4a)."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_fc_telemetry_msg", "label": "RadioLink.fc_telemetry (protocol 6: battery, attitude, flight mode, age)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HUD shows Betaflight's values while telemetry is fresh and dashes when it is not - goggles behaviour; the sim-internal battery stays on the bus for Python and logs."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_telemetry_fifo", "label": "Downlink telemetry scheduler (every 4th slot, FIFO 16, drop-oldest)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the FIFO is full the oldest frame is dropped: stale data yields to fresh, matching a radio that cannot retransmit; no new random draws so lockstep stays bit-identical."}, {"id": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_pwm_stays", "label": "Motor protocol stays PWM (spike superseded DShot switch)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "decision 2-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DSHOT600 command-path realism was an unverified SITL path with bridge and ESC-model rework and no fidelity gain the behavioural ESC can show; the battery stays on the proven KISS ESC-sensor UART."}], "edges": [{"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design", "target": "docs_superpowers_specs_2026_10_10_m3c_world_collision_elrs_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "header (predecessor; builds on M3c's merged output)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design", "target": "docs_superpowers_specs_2026_10_04_open_fpv_sim_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "header (parent spec 4, 5, 9)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_crsf_downlink", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_fc_telemetry_msg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "6 (protocol 6 carries fc_telemetry)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_crsf_downlink", "target": "docs_superpowers_specs_2026_10_10_m3c_world_collision_elrs_design_elrs_link", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "5 (on M3c's rewritten link the downlink gains telemetry slots)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_dshot_emulation", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_erpm_block", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "3 (the stub consumes the datagram block's per-motor eRPM)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_erpm_block", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_rpm_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "2-3 (the block feeds getMotorFrequencyHz, the RPM filter's input)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_pole_pairs_const", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_erpm_block", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "3 (eRPM = omega * 60/2pi * pole pairs, the KISS shim's constant)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_telemetry_fifo", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_crsf_downlink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-10-m3d-fc-telemetry-design.md", "source_location": "5 (the downlink scheduler carries the frames)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_pwm_stays", "target": "docs_superpowers_specs_2026_10_10_m3d_fc_telemetry_design_dshot_emulation", "relation": "rationale_for", "c