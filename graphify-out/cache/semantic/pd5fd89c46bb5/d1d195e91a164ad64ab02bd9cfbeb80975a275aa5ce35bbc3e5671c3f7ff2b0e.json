{"nodes": [{"id": "docs_research_sitl_interface_md", "label": "Betaflight SITL Interface \u2014 M0 Findings (docs/research/sitl-interface.md)", "file_type": "document", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_pinned_betaflight", "label": "Pinned Betaflight 2026.6.2 (commit e0b7bb01)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_lockstep_patch", "label": "SITL lockstep patch (ENABLE_SIMULATOR_EXTERNAL_TIME)", "file_type": "rationale", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock SITL cannot run in lockstep: its clock is wall time x simRate and collapses under request/response pacing. The patch makes every state packet get exactly one motor reply, bit-identical runs at 6-7x real time; the exchange rate must equal Betaflight's gyro rate."}, {"id": "docs_research_sitl_interface_ports", "label": "SITL fixed ports (UDP 9001-9004, TCP 5760+)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one SITL session can run per machine and SITL tests must not run in parallel."}, {"id": "docs_research_sitl_interface_sign_conventions", "label": "FRD-to-FLU sign conventions and AETR channel order (8/8 checks)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_combined_datagram", "label": "184-byte combined fdm+rc state datagram (UDP 9003)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_uart_in_datagram", "label": "UART bytes in the state datagram (deterministic CRSF to Betaflight)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_deterministic_boot", "label": "Deterministic boot fix ([SITL] ready for the simulator)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_reboots", "label": "Betaflight reboots as firmware restarts (systemReset to exit(0), relaunch from EEPROM)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_failsafe_timing", "label": "Failsafe timing (frames stop, failsafe_delay 1.5 s, JUST_DISARM/DROP)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_feature_build", "label": "SITL feature build (CRSF RX, ESC sensor, DisplayPort OSD, SmartAudio, Blackbox)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_reply_datagram", "label": "Reply datagram TX capture (dropped count + UART blocks, REPLY_MAX 530, UART1 never captured)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_use_osd_sd", "label": "USE_OSD_SD define (30x16 PAL OSD grid)", "file_type": "rationale", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without USE_OSD_SD, displayPortMspInit() runs both fallback blocks and always leaves vcd_video_system at AUTO, so the OSD is a 13-row NTSC grid whatever the diff says; with it, vcd_video_system = PAL takes effect and the grid is 30 x 16."}, {"id": "docs_research_sitl_interface_smartaudio_facts", "label": "SmartAudio facts (CRC excludes preamble, 1-based power index, no vtxtable in SITL)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_wsl_nat", "label": "WSL2 NAT networking discovery (WSL VM IP + --ip host IP, OFS_SITL_HOST/OFS_SITL_REPLY_IP)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_crsf_telemetry_shim", "label": "CRSF telemetry atomic-block shim (M3d)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "USE_TELEMETRY_CRSF was off only because the SITL target.h #undef'd it and mk/SITL.mk excluded the file; atomic.h takes its software-BASEPRI branch for SIMULATOR_BUILD, a 4-edit shim, upstreamable."}, {"id": "docs_research_sitl_interface_dshot_stub", "label": "DShot telemetry stub without USE_DSHOT (RPM filter gate)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RPM filter needs no DShot driver at all: it gates on the useDshotTelemetry global that the sitl.c ESC-sensor stub owns, so USE_DSHOT_TELEMETRY and USE_RPM_FILTER compile without dshot.c's DMA/timer hardware."}, {"id": "docs_research_sitl_interface_upstream_bugs", "label": "Upstream Betaflight bugs found (osd.c storageTotal division trap, osdEscDataCombined NULL deref)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_sitl_interface_patch_generators", "label": "Patch generator scripts (add_serial_in_datagram, deterministic_boot, add_serial_out_datagram \u2014 run in that order)", "file_type": "concept", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "third_party_betaflight_ofs_sitl_patch", "label": "third_party/betaflight/ofs-sitl.patch", "file_type": "code", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "betaflight_telemetry_crsf_c", "label": "Betaflight telemetry/crsf.c (CRSF telemetry source of truth)", "file_type": "code", "source_file": "docs/research/sitl-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_sitl_interface_md", "target": "docs_research_sitl_interface_lockstep_patch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/sitl-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_sitl_interface_md", "target": "docs_research_sitl_interface_combined_datagram", "relation": "references", "co