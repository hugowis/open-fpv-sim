{"nodes": [{"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design", "label": "M3b Analog Video Link and Degradation Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_world_file", "label": "World file (worlds/flat.toml: pilot, receiver, objects, emitters)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_video_link_model", "label": "VideoLink model (ofs-video::link, 50 Hz fields)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server owns the whole receiver model so it is testable headless; the model exists only when the quad has [vtx] and computes at reception time."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_propagation", "label": "ofs-video::propagation pure functions (FSPL, patterns, obstruction)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shaped as pure functions so the ELRS link can adopt them later (M3c does)."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_knife_edge", "label": "Knife-edge obstruction (ITU-R P.526)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Going behind a building fades over a few metres instead of switching off; losses capped at each object's rf_loss_db."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_ground_bounce", "label": "Two-ray ground bounce (circular polarization suppression)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reflection flips circular handedness, so circular antennas take the reflected ray with the cross-polarization loss - which is why FPV uses circular polarization."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_rician_fading", "label": "Seeded Rician fading (AR(1), obstruction-lowered K-factor)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlated over the distance the quad has moved (about lambda/2), so a hovering quad is steady and fast flight flickers; the seeded stream keeps lockstep deterministic."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_diversity", "label": "Receiver antenna diversity (2 dB switching hysteresis)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_sync_thresholds", "label": "Receiver sync thresholds (25/12/8/6/3 dB grain-sparkle-chroma-sync bands)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analog FM threshold effect: sync unstable below 6 dB, lost after 3 consecutive fields below 3 dB, relocks after 5 fields back above 6 dB; named constants with provenance 'estimated'."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_degradation_shader", "label": "Analog degradation shader (godot/ui/video.gd)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the screen below (scene, lens, OSD) so the OSD breaks up with the picture; photosensitivity constraints: no full-screen bright flashes, static is fine-grained mid-grey noise."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_server_owns_world", "label": "Server owns the world and the whole receiver model", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "decision 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Godot ray casts sent to the server would leave occlusion untestable headless; the shader only renders the quality values."}, {"id": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_protocol_4", "label": "Protocol 4 (GetWorld RPC, State.video)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_vtx_model", "target": "docs_superpowers_specs_2026_10_09_m3b_video_link_design_video_link_model", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-09-m3b-video-link-design.md", "source_location": "1/3 (the link model turns the VTX state M3a publishes)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_09_m3b_video_link_design", "