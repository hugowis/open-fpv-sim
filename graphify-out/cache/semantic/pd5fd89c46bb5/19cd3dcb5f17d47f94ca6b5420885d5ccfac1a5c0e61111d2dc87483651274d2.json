{"nodes": [{"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design", "label": "M3a OSD and VTX Control Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_m3_split", "label": "Split of M3 into M3a (Betaflight-facing) and M3b (link model)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M3a covers everything Betaflight-facing (OSD, SmartAudio, ESC telemetry); the analog link model and degradation shader are driven by the VTX state M3a publishes."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_msp_displayport_osd", "label": "Betaflight OSD over MSP DisplayPort (ofs-video::osd)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cells carry a character code, a font page and a blink flag; draw publishes a snapshot so a half-drawn screen is never shown; the OSD is drawn inside the FPV render path so it can degrade."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_osd_frame", "label": "OsdFrame stream (30x16 grid, snapshot on draw)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published only when the cells changed, at most 60 Hz; present=false after 1 s without a draw; lockstep runs produce identical frames."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_smartaudio_codec", "label": "SmartAudio v2.1 codec", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bad CRC or unknown command is ignored (as a real VTX would) and counted; a short configurable reply latency stands in for the real VTX; Tramp rejected for M3a but addable behind the same VTX model."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_vtx_model", "label": "VtxModel (ofs-video)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frequency, power and pit mode are published as bus signals - the input for M3b's link model."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_kiss_esc_telemetry", "label": "Battery as KISS ESC telemetry (quarter-current frames)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Betaflight's ESC sensor sums current and consumption over its four motor slots and averages voltage and RPM, so every frame carries a quarter of the pack's current and consumed charge and the pack's terminal voltage."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_sitl_uart_reply_patch", "label": "SITL UART TX bytes in the reply datagram (patch extension)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "2, decision 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCP on the UART ports would give wall-clock timing; the reply datagram is deterministic and tick-bound so lockstep OSD stays bit-identical."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_font_atlas", "label": "OSD font atlas converted from Betaflight .mcm", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "3, decision 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Betaflight sends character codes, not pictures; the symbols only look right with this font; official GPL-3.0 font with a committed license notice and conversion script."}, {"id": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_protocol_3", "label": "Protocol 3 (StreamOsd, Vtx state message)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design", "target": "docs_superpowers_specs_2026_10_04_open_fpv_sim_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "header (parent spec 4.2, 5.4, 9)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_m3_split", "target": "docs_superpowers_specs_2026_10_09_m3b_video_link_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "1 (M3b later spec: the analog link model driven by M3a's VTX state)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_msp_displayport_osd", "target": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_osd_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "3 (draw publishes an OsdFrame snapshot)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_osd_frame", "target": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_protocol_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "6 (StreamOsd sends OsdFrame)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_smartaudio_codec", "target": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_vtx_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "4 (the codec feeds the model's state)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_kiss_esc_telemetry", "target": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_sitl_uart_reply_patch", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "2 (both ride the SITL serial datagram extension)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_font_atlas", "target": "godot_ui_osd_font_license_atlas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "3 (the font is converted once with the license notice beside it)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_08_m3a_osd_vtx_design_font_atlas", "target": "godot_ui_osd_font_license_gpl3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-08-m3a-osd-vtx-design.md", "source_location": "decision 5 (official .mcm, GPL-3.0, license notice committed)", "weight": 1.0}], "hyperedges": []}