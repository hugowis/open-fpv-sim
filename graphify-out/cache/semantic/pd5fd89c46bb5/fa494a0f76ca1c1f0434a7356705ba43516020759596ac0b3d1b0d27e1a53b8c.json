{"nodes": [{"id": "docs_research_collision_md", "label": "How the quad collides with the world (docs/research/collision.md)", "file_type": "document", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_collision_impulse_contact_model", "label": "Impulse contact model for world objects", "file_type": "rationale", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An impulse has no stiffness and no damper to integrate and bounds the velocity change directly in one step; at 8 kHz a 30 m/s quad moves 3.75 mm per step, a fifth of a prop sphere, so nothing tunnels. The ground keeps its spring-damper because a landed quad must sit still for minutes, while impulses bound hits no stable spring could."}, {"id": "docs_research_collision_penalty_spring_failure", "label": "Penalty spring failure analysis (why not a spring for walls)", "file_type": "rationale", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stiffness a wall needs grows with the square of the speed and the inverse square of the allowed sink; the marginal stop has no margin and the explicit step must fit inside the sink (dt < 2m/c at critical damping), so firmness costs the entire physics budget."}, {"id": "docs_research_collision_signed_distance_solids", "label": "Signed-distance solids (boxes, cylinders, ground half-space)", "file_type": "concept", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_collision_contact_resolution", "label": "Contact resolution (collect, position correction, deepest-first impulses, Coulomb friction)", "file_type": "concept", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impulses are applied one contact at a time, deepest first, ties by object index, in a fixed order, so the same inputs give bit-identical flights. Restitution is 0 for inward speeds below 0.2 m/s so a resting quad has nothing to jitter about."}, {"id": "docs_research_collision_landing_contact_points", "label": "Landing contact points (M1 spring-damper, now against objects too)", "file_type": "concept", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two mechanisms answer two different questions: the spring-damper carries a resting weight stably for minutes, the impulses bound hits no stable spring could."}, {"id": "docs_research_collision_collision_spheres", "label": "Generated collision spheres (6 per prop tip at 2 cm + 4 cm body sphere)", "file_type": "concept", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_collision_no_gap_claim", "label": "No-gap-admits-a-12-cm-post safety claim", "file_type": "rationale", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six 2 cm spheres per tip circle leave a worst ring-to-body gap of 11.5 cm of air; the spec's original 1.5 cm prop spheres failed the claim by 0.24 mm, so the radius is 2 cm."}, {"id": "docs_research_collision_collision_event", "label": "COLLISION events (1 m/s inward threshold, 20 ms rearm, HIT/HARD LANDING messages)", "file_type": "concept", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crates_ofs_physics_src_collision_rs", "label": "crates/ofs-physics/src/collision.rs (impulses and events)", "file_type": "code", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crates_ofs_physics_src_rigid_body_rs", "label": "crates/ofs-physics/src/rigid_body.rs (contact half, landing points)", "file_type": "code", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crates_ofs_core_src_shape_rs", "label": "ofs_core::shape (crates/ofs-core/src/shape.rs: signed distances, normals, bounds)", "file_type": "code", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_10_m3c_world_collision_elrs_design_md", "label": "M3c world collision + ELRS design spec (2026-10-10)", "file_type": "document", "source_file": "docs/research/collision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_collision_md", "target": "crates_ofs_physics_src_collision_rs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/collision.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_collision_md", "target": "crates_ofs_physics_src_rigid_body_rs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/collision.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_collision_md", "target": "crates_ofs_core_src_shape_rs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/collision.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_collision_md", "target": "docs_super