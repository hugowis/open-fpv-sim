diff --git a/src/platform/SIMULATOR/sitl.c b/src/platform/SIMULATOR/sitl.c
index 4a9e08b..1627759 100644
--- a/src/platform/SIMULATOR/sitl.c
+++ b/src/platform/SIMULATOR/sitl.c
@@ -828,11 +828,16 @@ void systemInit(void)
 #if ENABLE_SIMULATOR_EXTERNAL_TIME
     {
         // The idle wait must not jump with wall-clock steps (WSL2 resyncs its clock after host sleep).
+#if defined(__APPLE__)
+        // macOS has no pthread_condattr_setclock (see the relative wait in simulatorSchedulerIdle).
+        pthread_cond_init(&extPacketCond, NULL);
+#else
         pthread_condattr_t attr;
         pthread_condattr_init(&attr);
         pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
         pthread_cond_init(&extPacketCond, &attr);
         pthread_condattr_destroy(&attr);
+#endif
     }
 #endif
     printf("[system]Init...\n");
@@ -1270,6 +1275,12 @@ void simulatorSchedulerIdle(void)
     // so wall-time behaviour before the first packet and TCP serial traffic are still serviced).
     pthread_mutex_lock(&extPacketMutex);
     if (extGyroTicks == extGyroTicksTaken) {
+#if defined(__APPLE__)
+        // A relative 1 ms wait: macOS conditions cannot be given a monotonic clock, and an absolute realtime deadline would
+        // stretch if the wall clock stepped back.
+        const struct timespec relative = { 0, 1000000 };
+        pthread_cond_timedwait_relative_np(&extPacketCond, &extPacketMutex, &relative);
+#else
         struct timespec until;
         clock_gettime(CLOCK_MONOTONIC, &until);  // extPacketCond uses CLOCK_MONOTONIC (systemInit)
         until.tv_nsec += 1000000;
@@ -1278,6 +1289,7 @@ void simulatorSchedulerIdle(void)
             until.tv_nsec -= 1000000000;
         }
         pthread_cond_timedwait(&extPacketCond, &extPacketMutex, &until);
+#endif
     }
     pthread_mutex_unlock(&extPacketMutex);
 }
