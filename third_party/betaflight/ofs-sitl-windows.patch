diff --git a/src/platform/SIMULATOR/win_stubs.c b/src/platform/SIMULATOR/win_stubs.c
new file mode 100644
index 0000000..267e345
--- /dev/null
+++ b/src/platform/SIMULATOR/win_stubs.c
@@ -0,0 +1,23 @@
+// Windows (PE) build only. Code that the Linux SITL link drops as unreachable stays in this one and refers to
+// hardware-only symbols: --gc-sections removed nothing here, and this build has no LTO (the Linux build has, which
+// also drops unreferenced code; which of the two matters is not established). Define the symbols so the link
+// succeeds; a function stub that is ever called says so and aborts.
+#if defined(_WIN32) || defined(__CYGWIN__)
+#include <stdio.h>
+#include <stdlib.h>
+#define STUB_CALLED(name) do { fprintf(stderr, "[SITL] win_stubs.c: %s was called\n", name); abort(); } while (0)
+char dmaDescriptors[256];
+char gpsLapTimerConfig_System[256];
+int dmaGetHandlerCount(void) { STUB_CALLED("dmaGetHandlerCount"); return 0; }
+int IORead(void *io) { (void)io; STUB_CALLED("IORead"); return 0; }
+void audioSetupIO(void) { STUB_CALLED("audioSetupIO"); }
+void audioGenerateWhiteNoise(void) { STUB_CALLED("audioGenerateWhiteNoise"); }
+void audioSilence(void) { STUB_CALLED("audioSilence"); }
+void audioPlayTone(void) { STUB_CALLED("audioPlayTone"); }
+int mpuGyroReadRegister(void) { STUB_CALLED("mpuGyroReadRegister"); return 0; }
+float clockCyclesToMicrosf(unsigned c) { (void)c; STUB_CALLED("clockCyclesToMicrosf"); return 0; }
+void hottTextmodeWriteChar(void) { STUB_CALLED("hottTextmodeWriteChar"); }
+void hottTextmodeGrab(void) { STUB_CALLED("hottTextmodeGrab"); }
+int hottTextmodeIsAlive(void) { STUB_CALLED("hottTextmodeIsAlive"); return 0; }
+void hottTextmodeExit(void) { STUB_CALLED("hottTextmodeExit"); }
+#endif
