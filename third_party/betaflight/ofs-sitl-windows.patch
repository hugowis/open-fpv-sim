--- /dev/null
+++ b/src/platform/SIMULATOR/win_stubs.c
@@ -0,0 +1,18 @@
+// Windows (PE) build only: --gc-sections removed nothing in this link, so code that the other SITL builds drop as
+// unreachable stays and refers to hardware-only symbols. Define them (never called) so the link succeeds.
+#if defined(_WIN32) || defined(__CYGWIN__)
+char dmaDescriptors[256];
+char gpsLapTimerConfig_System[256];
+int dmaGetHandlerCount(void) { return 0; }
+int IORead(void *io) { (void)io; return 0; }
+void audioSetupIO(void) {}
+void audioGenerateWhiteNoise(void) {}
+void audioSilence(void) {}
+void audioPlayTone(void) {}
+int mpuGyroReadRegister(void) { return 0; }
+float clockCyclesToMicrosf(unsigned c) { return (float)c; }
+void hottTextmodeWriteChar(void) {}
+void hottTextmodeGrab(void) {}
+int hottTextmodeIsAlive(void) { return 0; }
+void hottTextmodeExit(void) {}
+#endif
